APP_NAME=AgileFlow AI
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agileflow_ai
JWT_SECRET_KEY=change-me-for-local-development
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Structured model provider used by standalone specialist agents
# Local inference via llama.cpp (no API key required):
# MODEL_PROVIDER=llama_cpp
# MODEL_BASE_URL=http://127.0.0.1:8080
# MODEL_NAME=Qwen3-4B-Instruct-2507-Q4_K_M
# MODEL_TIMEOUT_SECONDS=120
#
# Commercial / Cloud inference (requires API key):
MODEL_PROVIDER=openai_compatible
MODEL_API_KEY=
MODEL_NAME=gpt-4.1-mini
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_TIMEOUT_SECONDS=60
