APP_NAME=AgileFlow AI
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agileflow_ai
AGENT1_SOURCE_ROOT=storage/standalone/requirements
TRANSCRIPTION_PROVIDER=faster_whisper
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_LANGUAGE=
VIDEO_FFMPEG_PATH=ffmpeg
VIDEO_FFMPEG_TIMEOUT_SECONDS=120
AGENT1_CHUNK_TARGET_CHARS=900
AGENT1_CHUNK_MAX_CHARS=1200
AGENT1_CHUNK_OVERLAP_SENTENCES=1
AGENT3_ZERO_SHOT_LOCAL_FILES_ONLY=false
AGENT3_SEMANTIC_MODEL_ID=Qwen/Qwen3-1.7B
AGENT3_SEMANTIC_MODEL_REVISION=70d244cc86ccca08cf5af4e1e306ecf908b1ad5e
AGENT3_SEMANTIC_LOCAL_FILES_ONLY=false
AGENT3_SEMANTIC_DEVICE=auto
JWT_SECRET_KEY=change-me-for-local-development
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Structured model provider used by standalone specialist agents
MODEL_PROVIDER=openai_compatible
MODEL_API_KEY=
MODEL_NAME=gpt-4.1-mini
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_TIMEOUT_SECONDS=60
# Local staged Agent 3 inputs; relative paths resolve from the backend process.
AGENT3_UPLOAD_ROOT=storage/standalone/implementation
# Project-scoped Agent 4 Stage 1 resources, beginning with workflow.json.
AGENT4_STORAGE_ROOT=storage/standalone/testing-validation
# GitHub App user-connection settings. Keep real credentials only in .env.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_SETUP_CALLBACK_URL=http://localhost:8000/api/v1/agents/implementation/github/install-callback
GITHUB_APP_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/agents/implementation/github/oauth-callback
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEB_BASE_URL=https://github.com
GITHUB_API_BASE_URL=https://api.github.com
FRONTEND_BASE_URL=http://localhost:5173
GITHUB_HTTP_TIMEOUT_SECONDS=10
