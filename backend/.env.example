APP_NAME=AgileFlow AI
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agileflow_ai
JWT_SECRET_KEY=change-me-for-local-development
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Structured model provider used by standalone specialist agents
MODEL_PROVIDER=openai_compatible
MODEL_API_KEY=
MODEL_NAME=gpt-4.1-mini
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_TIMEOUT_SECONDS=60
# Requirement-source upload storage and per-file limit
UPLOAD_DIR=../storage/uploads
MAX_UPLOAD_SIZE_BYTES=52428800
# Speech-to-text is configured separately from requirement-generation models
TRANSCRIPTION_PROVIDER=openai_compatible
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_TIMEOUT_SECONDS=120
# Optional ISO-639-1 hint, for example: en
TRANSCRIPTION_LANGUAGE=
